import { put, del } from "@vercel/blob";

/* api/data.js 와 같은 토큰을 씁니다 */
const TOKENS = { "2026": 0 };

const OK_TYPE = { "image/jpeg": "jpg", "image/png": "png", "image/webp": "webp" };
const MAX_BYTES = 1_200_000;      // 브라우저에서 줄인 뒤 올라오는 크기 (보통 300~500KB)

async function readBody(req) {
  if (req.body !== undefined && req.body !== null) {
    return typeof req.body === "string" ? JSON.parse(req.body) : req.body;
  }
  const chunks = [];
  let total = 0;
  for await (const c of req) {
    total += c.length;
    if (total > 6_000_000) throw new Error("too big");
    chunks.push(c);
  }
  return JSON.parse(Buffer.concat(chunks).toString("utf8"));
}

export default async function handler(req, res) {
  res.setHeader("Cache-Control", "no-store");
  if (req.method !== "POST") return res.status(405).json({ ok: false });

  let body;
  try {
    body = await readBody(req);
  } catch (e) {
    return res.status(400).json({ ok: false, msg: "body" });
  }

  /* ── 본부가 사진을 지울 때 ── */
  if (body.action === "del") {
    if (TOKENS[body.token] === undefined) {
      return res.status(403).json({ ok: false, msg: "token" });
    }
    if (!body.url) return res.status(400).json({ ok: false, msg: "url" });
    try {
      await del(body.url);
    } catch (e) {
      /* 이미 지워진 파일이면 그냥 넘어갑니다 */
    }
    return res.status(200).json({ ok: true });
  }

  /* ── 학생·교사가 사진을 올릴 때 (토큰 없이) ── */
  const type = String(body.type || "");
  const ext = OK_TYPE[type];
  if (!ext) return res.status(400).json({ ok: false, msg: "type" });

  const b64 = String(body.data || "").replace(/^data:[^,]+,/, "");
  if (!b64) return res.status(400).json({ ok: false, msg: "empty" });
  if (b64.length > MAX_BYTES * 1.4) return res.status(413).json({ ok: false, msg: "size" });

  let buf;
  try {
    buf = Buffer.from(b64, "base64");
  } catch (e) {
    return res.status(400).json({ ok: false, msg: "decode" });
  }
  if (!buf.length) return res.status(400).json({ ok: false, msg: "empty" });
  if (buf.length > MAX_BYTES) return res.status(413).json({ ok: false, msg: "size" });

  /* 실제로 이미지인지 앞부분 바이트로 확인합니다 */
  const isJpg = buf[0] === 0xff && buf[1] === 0xd8;
  const isPng = buf[0] === 0x89 && buf[1] === 0x50 && buf[2] === 0x4e && buf[3] === 0x47;
  const isWeb = buf.slice(0, 4).toString("ascii") === "RIFF" &&
                buf.slice(8, 12).toString("ascii") === "WEBP";
  if (!(isJpg || isPng || isWeb)) return res.status(400).json({ ok: false, msg: "notimage" });

  const safe = String(body.school || "team").replace(/[^가-힣A-Za-z0-9]/g, "").slice(0, 12) || "team";
  const stamp = new Date().toISOString().slice(0, 10);

  try {
    const r = await put(`photo/${stamp}-${safe}.${ext}`, buf, {
      access: "public",
      addRandomSuffix: true,
      contentType: type,
      cacheControlMaxAge: 60 * 60 * 24 * 30
    });
    return res.status(200).json({ ok: true, url: r.url, pathname: r.pathname });
  } catch (e) {
    return res.status(500).json({ ok: false, msg: "store" });
  }
}
